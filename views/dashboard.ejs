<%- include('partials/header') %>

<div class="container my-4">

  <!-- Welcome Banner -->
  <div class="card card-dark-blue shadow-sm mb-4 border-0 overflow-hidden position-relative">
    <div class="card-body p-4 p-md-5 position-relative" style="z-index: 1;">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
          <h1 class="display-6 fw-bold mb-2">
            Welcome back, <span style="color: var(--accent-cyan);"><%= user.name %></span>!
          </h1>
          <p class="text-secondary mb-0 fs-6">
            System Account Access: 
            <span class="badge rounded-pill text-uppercase px-3 py-2 ms-2" style="background-color: var(--accent-blue);">
              <i class="bi bi-shield-lock me-1"></i><%= user.role %>
            </span>
          </p>
        </div>
        <% if (user.role === 'user' || user.role === 'customer') { %>
          <a href="/tickets/new" class="btn btn-glow px-4 py-2 fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Create New Ticket
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger bg-danger text-white border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- ========================================== -->
  <!-- 1. TECHNICIAN SUMMARY & REVIEWS           -->
  <!-- ========================================== -->
  <% if (user.role === 'tech') { %>
    <div class="row g-4 mb-4">
      <!-- Rating Metric Box -->
      <div class="col-md-4">
        <div class="card card-dark-blue shadow-sm border-0 text-center p-4 h-100 d-flex flex-column justify-content-center" style="background: linear-gradient(135deg, rgba(28, 37, 65, 0.95), rgba(255, 193, 7, 0.1)); border: 1px solid rgba(255, 193, 7, 0.3) !important;">
          <h6 class="text-secondary fw-bold text-uppercase tracking-wider small mb-2"><i class="bi bi-star-fill text-warning me-1"></i> Performance Rating</h6>
          <h2 class="fw-bold text-warning mb-1 display-5">
            <%= typeof avgRating !== 'undefined' ? avgRating : '0.0' %> <span class="fs-4 text-secondary">/ 5.0</span>
          </h2>
          <small class="text-secondary">(<%= reviews ? reviews.length : 0 %> total reviews)</small>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="col-md-8">
        <div class="row g-3 h-100">
          <div class="col-6 col-sm-3">
            <div class="card card-dark-blue p-3 text-center shadow-sm h-100 justify-content-center">
              <span class="text-secondary small d-block mb-1">Total Tickets</span>
              <strong class="fs-3 text-white"><%= stats.total %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="card card-dark-blue p-3 text-center shadow-sm h-100 justify-content-center border-danger border-opacity-25">
              <span class="text-secondary small d-block mb-1">Open</span>
              <strong class="fs-3 text-danger"><%= stats.open %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="card card-dark-blue p-3 text-center shadow-sm h-100 justify-content-center border-warning border-opacity-25">
              <span class="text-secondary small d-block mb-1">In Progress</span>
              <strong class="fs-3 text-warning"><%= stats.inProgress %></strong>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="card card-dark-blue p-3 text-center shadow-sm h-100 justify-content-center border-success border-opacity-25">
              <span class="text-secondary small d-block mb-1">Completed</span>
              <strong class="fs-3 text-success"><%= stats.closed %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Technician Feedback List -->
    <div class="card card-dark-blue shadow-sm mb-4">
      <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
        <h5 class="fw-bold mb-0 text-white"><i class="bi bi-chat-square-quote text-info me-2"></i>Customer Reviews & Feedback</h5>
      </div>
      <div class="card-body p-0">
        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
          <div class="list-group list-group-flush">
            <% reviews.forEach(r => { %>
              <div class="list-group-item bg-transparent text-white border-bottom border-secondary-subtle py-3 px-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <div>
                    <strong class="text-white fs-6"><%= r.customer ? r.customer.name : 'Customer' %></strong>
                    <span class="badge bg-secondary ms-2">Ticket #<%= r.Ticket ? r.Ticket.id : r.ticketId %></span>
                  </div>
                  <span class="badge bg-warning text-dark fs-6 px-3 py-1"><%= r.rating %> ★</span>
                </div>
                <p class="mb-2 text-secondary"><%= r.comment || 'No written feedback provided.' %></p>
                <small class="text-secondary">Speed Score: <strong class="text-white"><%= r.speedRating %>/5</strong> · Submitted <%= new Date(r.createdAt).toLocaleDateString() %></small>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-secondary text-center my-4 py-3">No reviews received yet.</p>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- ========================================== -->
  <!-- 2. ADMIN REVIEWS OVERVIEW                  -->
  <!-- ========================================== -->
  <% if (user.role === 'admin') { %>
    <div class="card card-dark-blue shadow-sm mb-4">
      <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-white"><i class="bi bi-stars text-warning me-2"></i>System Technician Reviews</h5>
        <span class="badge rounded-pill text-uppercase" style="background-color: var(--accent-blue);"><%= reviews ? reviews.length : 0 %> Total Reviews</span>
      </div>
      <div class="card-body p-0">
        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
              <thead>
                <tr class="text-secondary small text-uppercase" style="border-bottom: 1px solid var(--border-blue);">
                  <th class="ps-4">Ticket</th>
                  <th>Technician</th>
                  <th>Customer</th>
                  <th>Rating</th>
                  <th>Speed Score</th>
                  <th>Comment</th>
                  <th class="pe-4">Date</th>
                </tr>
              </thead>
              <tbody>
                <% reviews.forEach(r => { %>
                  <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <td class="ps-4"><strong>#<%= r.Ticket ? r.Ticket.id : r.ticketId %></strong></td>
                    <td class="fw-bold text-info"><%= r.technician ? r.technician.name : 'Unassigned' %></td>
                    <td><%= r.customer ? r.customer.name : 'Anonymous' %></td>
                    <td><span class="badge bg-warning text-dark"><%= r.rating %> ★</span></td>
                    <td><%= r.speedRating %>/5</td>
                    <td class="text-truncate text-secondary" style="max-width: 250px;"><%= r.comment || '-' %></td>
                    <td class="pe-4"><small class="text-secondary"><%= new Date(r.createdAt).toLocaleDateString() %></small></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-secondary text-center my-4 py-3">No reviews recorded in the system yet.</p>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- ========================================== -->
  <!-- 3. MAIN TICKETS TABLE                      -->
  <!-- ========================================== -->
  <div class="card card-dark-blue shadow-sm">
    <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3 d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0 text-white"><i class="bi bi-ticket-perforated text-primary me-2"></i>Tickets Overview</h5>
      <% if (user.role === 'user' || user.role === 'customer') { %>
        <a href="/tickets/new" class="btn btn-outline-light btn-sm">+ Create Ticket</a>
      <% } %>
    </div>
    <div class="card-body p-0">
      <% if (tickets && tickets.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
            <thead>
              <tr class="text-secondary small text-uppercase" style="border-bottom: 1px solid var(--border-blue);">
                <th class="ps-4">ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Assigned Tech</th>
                <th class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody>
              <% tickets.forEach(t => { %>
                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                  <td class="ps-4 text-secondary"><strong>#<%= t.id %></strong></td>
                  <td class="fw-bold text-white"><%= t.title %></td>
                  <td><span class="badge bg-secondary bg-opacity-50 text-light"><%= t.Category ? t.Category.name : 'General' %></span></td>
                  <td>
                    <span class="badge <%= t.priority === 'High' ? 'bg-danger' : (t.priority === 'Medium' ? 'bg-warning text-dark' : 'bg-secondary') %>">
                      <%= t.priority %>
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= t.status === 'Open' ? 'bg-danger' : (t.status === 'In Progress' ? 'bg-warning text-dark' : 'bg-success') %>">
                      <%= t.status %>
                    </span>
                  </td>
                  <td class="text-secondary"><%= t.Technician ? t.Technician.name : 'Unassigned' %></td>
                  <td class="text-end pe-4">
                    <a href="/tickets/<%= t.id %>" class="btn btn-sm btn-outline-info px-3">
                      <i class="bi bi-eye me-1"></i>View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-secondary text-center my-4 py-3">No tickets found.</p>
      <% } %>
    </div>
  </div>

</div>

<%- include('partials/footer') %>