<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP | ServiceNode</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    :root {
      --bg-dark-blue: #0a1128;
      --card-blue: #1c2541;
      --border-blue: #2e3a59;
      --text-bright: #f8fafc;
      --text-subtle: #8d99ae;
      --accent-blue: #3a86ff;
      --accent-cyan: #00f5d4;
    }

    body {
      background-color: var(--bg-dark-blue);
      color: var(--text-bright);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      position: relative;
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* Ambient Blue Radial Glow Background */
    body::before {
      content: "";
      position: absolute;
      top: -15%;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(58, 134, 255, 0.18) 0%, rgba(0, 245, 212, 0.04) 55%, transparent 75%);
      z-index: 0;
      pointer-events: none;
      animation: pulseGlow 7s ease-in-out infinite alternate;
    }

    @keyframes pulseGlow {
      0% { transform: translateX(-50%) scale(0.95); opacity: 0.8; }
      100% { transform: translateX(-50%) scale(1.15); opacity: 1; }
    }

    /* Keyframe Card Entrance Animation */
    .animated-card {
      animation: cardEntrance 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      z-index: 1;
    }

    @keyframes cardEntrance {
      from {
        opacity: 0;
        transform: translateY(30px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Expanded Card Container */
    .card-dark-blue {
      background-color: rgba(28, 37, 65, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid var(--border-blue);
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    }

    .brand-logo {
      font-weight: 800;
      letter-spacing: -0.5px;
      font-size: 2rem;
    }

    /* Form Controls */
    .form-control-blue {
      background-color: #0d1527;
      border: 1px solid var(--border-blue);
      color: var(--text-bright);
      border-radius: 10px;
      padding: 0.85rem 1.1rem;
      font-size: 1.05rem;
      transition: all 0.25s ease;
    }

    .form-control-blue:focus {
      background-color: #0d1527;
      border-color: var(--accent-blue);
      color: var(--text-bright);
      box-shadow: 0 0 0 0.25rem rgba(58, 134, 255, 0.25);
    }

    .form-control-blue::placeholder {
      color: #4a5568;
    }

    /* OTP Code Specific Styling */
    .otp-input {
      letter-spacing: 0.35rem;
      font-weight: 700;
      color: var(--accent-cyan) !important;
    }

    /* Glow Interactive Button */
    .btn-glow {
      background: linear-gradient(135deg, var(--accent-blue), #2563eb);
      border: none;
      color: #ffffff;
      border-radius: 10px;
      padding: 0.85rem 1rem;
      font-size: 1.1rem;
      transition: all 0.25s ease;
      box-shadow: 0 6px 16px rgba(58, 134, 255, 0.35);
    }

    .btn-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(58, 134, 255, 0.5);
      color: #ffffff;
    }

    .btn-glow:active {
      transform: translateY(0);
    }

    .link-cyan {
      color: var(--accent-cyan);
      transition: color 0.2s ease;
    }

    .link-cyan:hover {
      color: #64dfdf;
    }
  </style>
</head>
<body class="d-flex align-items-center vh-100 py-5">

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-5">
        <div class="card card-dark-blue animated-card border-0">
          <div class="card-body p-4 p-sm-5">
            
            <!-- Brand Header -->
            <div class="text-center mb-4">
              <h3 class="brand-logo mb-1">
                <i class="bi bi-shield-lock-fill me-2" style="color: var(--accent-blue);"></i>Service<span style="color: var(--accent-cyan);">Node</span>
              </h3>
              <p class="text-secondary small mb-0 fs-6">Verify OTP & Reset Password</p>
            </div>

            <!-- Informational Help Box -->
            <div class="p-3 mb-4 rounded-3 text-secondary small" style="background-color: #0d1527; border: 1px solid var(--border-blue);">
              <i class="bi bi-info-circle text-info me-1"></i> Check your email inbox for the 6-digit OTP code sent to <strong class="text-white"><%= email %></strong>[cite: 4].
            </div>

            <!-- Error Message Alert -->
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger bg-danger text-white border-0 py-2 px-3 mb-4 rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div><%= error %></div>[cite: 4]
              </div>
            <% } %>

            <!-- Reset Password Form -->
            <form action="/reset-password" method="POST">[cite: 4]
              <input type="hidden" name="email" value="<%= email %>">[cite: 4]

              <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small mb-2">6-Digit OTP Code</label>[cite: 4]
                <input 
                  type="text" 
                  name="otp" 
                  class="form-control form-control-blue text-center fs-4 otp-input" 
                  required 
                  maxlength="6" 
                  placeholder="123456" 
                />[cite: 4]
              </div>

              <div class="mb-4">
                <label class="form-label fw-semibold text-secondary small mb-2">New Password</label>[cite: 4]
                <input 
                  type="password" 
                  name="newPassword" 
                  class="form-control form-control-blue" 
                  required 
                  placeholder="Enter new password" 
                />[cite: 4]
              </div>

              <button type="submit" class="btn btn-glow w-100 fw-bold mb-3 mt-2">
                Update Password <i class="bi bi-check-circle ms-1"></i>
              </button>
            </form>

            <!-- Back Link -->
            <div class="text-center pt-3 mt-3 border-top border-secondary-subtle">
              <span class="text-secondary small fs-6">Didn't receive a code?</span>
              <a href="/forgot-password" class="link-cyan small text-decoration-none fw-semibold fs-6 ms-1">Resend OTP</a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>