<%- include('../partials/header') %>

<div class="container my-4">
  <!-- Navigation Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">
        <i class="bi bi-ticket-detailed-fill me-2" style="color: var(--accent-blue);"></i>Ticket Details
      </h2>
      <p class="text-secondary small mb-0">Inspect issue status, view updates, and participate in discussion thread</p>
    </div>
    <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger bg-danger text-white border-0 shadow-sm alert-dismissible fade show mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- LEFT COLUMN: Ticket Summary, Message & Discussion -->
    <div class="col-lg-8">
      
      <!-- Main Ticket Summary Card -->
      <div class="card card-dark-blue shadow-sm mb-4 border-0">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
            <h3 class="card-title fw-bold text-white mb-0 fs-4">
              <span class="text-secondary">#<%= ticket.id %>:</span> <%= ticket.title %>
            </h3>
            <span class="badge <%= ticket.status === 'Open' ? 'bg-danger' : (ticket.status === 'In Progress' ? 'bg-warning text-dark' : 'bg-success') %> px-3 py-2 text-uppercase">
              <%= ticket.status %>
            </span>
          </div>

          <div class="mt-3">
            <label class="fw-semibold text-secondary small d-block mb-2">Ticket Description</label>
            <div class="p-3 rounded-3 text-white" style="background-color: #0d1527; border: 1px solid var(--border-blue); white-space: pre-line;"><%= ticket.description %></div>
          </div>
        </div>
      </div>

      <!-- Discussion & Activity Thread Card -->
      <div class="card card-dark-blue shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
          <h5 class="fw-bold mb-0 text-white"><i class="bi bi-chat-left-dots-fill text-info me-2"></i>Discussion & Activity Log</h5>
        </div>
        <div class="card-body p-4">
          
          <!-- Comments History -->
          <% if (ticket.Comments && ticket.Comments.length > 0) { %>
            <div id="commentContainer" class="pe-2 mb-4" style="max-height: 380px; overflow-y: auto;">
              <% ticket.Comments.forEach(comment => { %>
                <div class="p-3 mb-3 rounded-3" style="background-color: #0d1527; border: 1px solid var(--border-blue);">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-person-circle text-info"></i>
                      <strong class="text-white"><%= comment.User ? comment.User.name : 'User' %></strong>
                      <span class="badge rounded-pill text-uppercase px-2 py-1" style="background-color: var(--accent-blue); font-size: 0.7rem;"><%= comment.User ? comment.User.role : 'user' %></span>
                    </div>
                    <small class="text-secondary"><%= new Date(comment.createdAt).toLocaleDateString() %></small>
                  </div>
                  <p class="mb-0 text-secondary small" style="white-space: pre-line;"><%= comment.message %></p>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-secondary text-center py-4 my-2">No comments added to this ticket thread yet.</p>
          <% } %>

          <!-- New Comment Input Form -->
          <form action="/tickets/<%= ticket.id %>/comments" method="POST" class="pt-3 border-top border-secondary-subtle">
            <div class="mb-3">
              <label for="message" class="form-label fw-semibold text-secondary small mb-2">Post Response / Note</label>
              <textarea 
                name="message" 
                id="message" 
                rows="3" 
                class="form-control text-white" 
                style="background-color: #0d1527; border: 1px solid var(--border-blue); border-radius: 10px;"
                placeholder="Type your reply, solution, or update here..." 
                required
              ></textarea>
            </div>
            <button type="submit" class="btn btn-glow btn-sm px-4 py-2 fw-semibold">
              <i class="bi bi-chat-square-text me-1"></i> Post Comment
            </button>
          </form>

        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Sidebar (Metadata, Technician Rating & Management) -->
    <div class="col-lg-4">
      
      <!-- Ticket Metadata Side-Card -->
      <div class="card card-dark-blue shadow-sm mb-4 border-0">
        <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
          <h5 class="fw-bold mb-0 text-white"><i class="bi bi-info-circle me-2 text-primary"></i>Information</h5>
        </div>
        <div class="card-body p-4">
          <table class="table table-dark table-borderless table-sm mb-0" style="background-color: transparent;">
            <tbody>
              <tr>
                <td class="text-secondary fw-semibold">Category:</td>
                <td class="text-end fw-bold text-white"><%= ticket.Category ? ticket.Category.name : 'General' %></td>
              </tr>
              <tr>
                <td class="text-secondary fw-semibold">Priority:</td>
                <td class="text-end">
                  <span class="fw-bold <%= ticket.priority === 'High' ? 'text-danger' : (ticket.priority === 'Medium' ? 'text-warning' : 'text-secondary') %>">
                    <%= ticket.priority %>
                  </span>
                </td>
              </tr>
              <tr>
                <td class="text-secondary fw-semibold">Requested By:</td>
                <td class="text-end text-white"><%= ticket.Creator ? ticket.Creator.name : 'Unknown' %></td>
              </tr>
              <tr>
                <td class="text-secondary fw-semibold">Assigned Tech:</td>
                <td class="text-end fw-bold text-info">
                  <%= ticket.Technician ? ticket.Technician.name : 'Unassigned' %>
                </td>
              </tr>
              <tr>
                <td class="text-secondary fw-semibold">Created Date:</td>
                <td class="text-end text-secondary"><%= new Date(ticket.createdAt).toLocaleDateString() %></td>
              </tr>
            </tbody>
          </table>

          <!-- 🌟 RATE TECHNICIAN BUTTON (When Completed or Resolved) -->
          <% if ((ticket.status === 'Completed' || ticket.status === 'Resolved' || ticket.status === 'Closed') && ticket.techId && user && (user.id === ticket.userId || user.role === 'customer' || user.role === 'user')) { %>
            <hr class="my-3 border-secondary-subtle">
            <div class="p-3 rounded-3 text-center" style="background-color: #0d1527; border: 1px solid rgba(255,193,7,0.3);">
              <p class="small text-secondary mb-2 fw-semibold">How was <%= ticket.Technician ? ticket.Technician.name : 'the technician' %>'s service?</p>
              <button type="button" class="btn btn-warning text-dark fw-bold w-100 shadow-sm" data-bs-toggle="modal" data-bs-target="#reviewModal">
                ⭐ Rate Technician
              </button>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Management Actions (Admins & Techs) -->
      <% if (user && (user.role === 'tech' || user.role === 'admin')) { %>
        <div class="card card-dark-blue shadow-sm border-0">
          <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
            <h5 class="fw-bold mb-0 text-white"><i class="bi bi-sliders me-2 text-warning"></i>Ticket Management</h5>
          </div>
          <div class="card-body p-4">
            <form action="/tickets/<%= ticket.id %>/update" method="POST">
              
              <!-- Status Selection -->
              <div class="mb-3">
                <label for="status" class="form-label fw-semibold text-secondary small mb-2">Update Status</label>
                <select 
                  name="status" 
                  id="status" 
                  class="form-select text-white" 
                  style="background-color: #0d1527; border: 1px solid var(--border-blue);"
                >
                  <option value="Open" <%= ticket.status === 'Open' ? 'selected' : '' %>>Open</option>
                  <option value="In Progress" <%= ticket.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                  <option value="Resolved" <%= ticket.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                  <option value="Closed" <%= ticket.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                </select>
              </div>

              <!-- Tech Assignment (Admin Only) -->
              <% if (user.role === 'admin') { %>
                <div class="mb-4">
                  <label for="techId" class="form-label fw-semibold text-secondary small mb-2">Assign Technician</label>
                  <select 
                    name="techId" 
                    id="techId" 
                    class="form-select text-white" 
                    style="background-color: #0d1527; border: 1px solid var(--border-blue);"
                  >
                    <option value="">-- Unassigned --</option>
                    <% if (typeof techUsers !== 'undefined' && techUsers) { %>
                      <% techUsers.forEach(t => { %>
                        <option value="<%= t.id %>" <%= ticket.techId === t.id ? 'selected' : '' %>>
                          <%= t.name %> (<%= t.role %>)
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
              <% } else if (user.role === 'tech' && !ticket.techId) { %>
                <input type="hidden" name="techId" value="<%= user.id %>">
              <% } %>

              <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                <%= (user.role === 'tech' && !ticket.techId) ? 'Claim & Update Ticket' : 'Update Ticket' %>
              </button>
            </form>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 🌟 TECHNICIAN RATING MODAL                  -->
<!-- ========================================== -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modal-content-dark shadow-lg">
      <div class="modal-header border-bottom border-secondary-subtle">
        <h5 class="modal-title fw-bold text-white" id="reviewModalLabel">
          ⭐ Rate <%= ticket.Technician ? ticket.Technician.name : 'Technician' %>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <form id="reviewForm">
        <div class="modal-body p-4">
          <input type="hidden" id="ticketId" name="ticketId" value="<%= ticket.id %>">
          <input type="hidden" id="technicianId" name="technicianId" value="<%= ticket.techId %>">

          <!-- Overall Star Selection Button Group -->
          <div class="mb-4 text-center">
            <label class="form-label fw-bold d-block text-white mb-2">Overall Quality Rating</label>
            <div class="btn-group w-100" role="group" aria-label="Overall Rating">
              <input type="radio" class="btn-check" name="rating" id="star1" value="1" autocomplete="off" required>
              <label class="btn btn-outline-warning" for="star1">1 ★</label>

              <input type="radio" class="btn-check" name="rating" id="star2" value="2" autocomplete="off">
              <label class="btn btn-outline-warning" for="star2">2 ★</label>

              <input type="radio" class="btn-check" name="rating" id="star3" value="3" autocomplete="off">
              <label class="btn btn-outline-warning" for="star3">3 ★</label>

              <input type="radio" class="btn-check" name="rating" id="star4" value="4" autocomplete="off">
              <label class="btn btn-outline-warning" for="star4">4 ★</label>

              <input type="radio" class="btn-check" name="rating" id="star5" value="5" autocomplete="off">
              <label class="btn btn-outline-warning" for="star5">5 ★</label>
            </div>
          </div>

          <!-- Repair Speed Rating Dropdown -->
          <div class="mb-3">
            <label for="speedRating" class="form-label fw-bold text-secondary small">Speed & Timeliness</label>
            <select class="form-select text-white" id="speedRating" name="speedRating" style="background-color: #0d1527; border: 1px solid var(--border-blue);" required>
              <option value="" selected disabled>Select speed rating...</option>
              <option value="5">⚡ Excellent (Very Fast)</option>
              <option value="4">👍 Good (On Time)</option>
              <option value="3">😐 Average</option>
              <option value="2">🐢 Slow</option>
              <option value="1">❌ Unacceptable Delay</option>
            </select>
          </div>

          <!-- Written Feedback Comment -->
          <div class="mb-3">
            <label for="comment" class="form-label fw-bold text-secondary small">Comments / Feedback</label>
            <textarea 
              class="form-control text-white" 
              id="comment" 
              name="comment" 
              rows="3" 
              style="background-color: #0d1527; border: 1px solid var(--border-blue);"
              placeholder="Tell us about your experience with this repair service..."
            ></textarea>
          </div>
          
          <div id="reviewAlert" class="alert d-none mt-3 mb-0" role="alert"></div>
        </div>

        <div class="modal-footer border-top border-secondary-subtle">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning text-dark fw-bold btn-sm px-3" id="submitReviewBtn">Submit Review</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- AJAX Submission Script -->
<script>
document.getElementById('reviewForm')?.addEventListener('submit', async function(e) {
  e.preventDefault();
  
  const submitBtn = document.getElementById('submitReviewBtn');
  const alertBox = document.getElementById('reviewAlert');
  submitBtn.disabled = true;

  const data = {
    ticketId: document.getElementById('ticketId').value,
    technicianId: document.getElementById('technicianId').value,
    rating: document.querySelector('input[name="rating"]:checked')?.value,
    speedRating: document.getElementById('speedRating').value,
    comment: document.getElementById('comment').value
  };

  try {
    const response = await fetch('/reviews/add', {
      method: 'POST',
      headers: new Headers({
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }),
      body: JSON.stringify(data)
    });

    const result = await response.json();

    if (response.ok) {
      alertBox.className = 'alert alert-success mt-3 mb-0';
      alertBox.textContent = result.message || 'Thank you! Your review has been submitted successfully.';
      alertBox.classList.remove('d-none');
      
      setTimeout(() => {
        window.location.reload();
      }, 1500);
    } else {
      alertBox.className = 'alert alert-danger mt-3 mb-0';
      alertBox.textContent = result.error || 'Failed to submit review.';
      alertBox.classList.remove('d-none');
      submitBtn.disabled = false;
    }
  } catch (error) {
    console.error('Submission error:', error);
    alertBox.className = 'alert alert-danger mt-3 mb-0';
    alertBox.textContent = 'Failed to communicate with server: ' + error.message;
    alertBox.classList.remove('d-none');
    submitBtn.disabled = false;
  }
});
</script>

<%- include('../partials/footer') %>