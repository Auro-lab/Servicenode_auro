<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ServiceNode | Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    :root {
      --bg-dark-blue: #0a1128;
      --card-blue: #1c2541;
      --border-blue: #2e3a59;
      --text-bright: #f8fafc;
      --text-subtle: #8d99ae;
      --accent-blue: #3a86ff;
      --accent-cyan: #00f5d4;
    }

    body {
      background-color: var(--bg-dark-blue);
      color: var(--text-bright);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
    }

    /* Navbar Styling */
    .navbar-custom {
      background-color: rgba(28, 37, 65, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-blue);
    }

    .brand-logo {
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--text-bright);
    }

    .nav-link-custom {
      color: var(--text-subtle) !important;
      font-weight: 500;
      transition: all 0.2s ease;
      border-radius: 8px;
      padding: 0.5rem 0.8rem !important;
    }

    .nav-link-custom:hover, .nav-link-custom.active {
      color: var(--text-bright) !important;
      background-color: rgba(255, 255, 255, 0.05);
    }

    /* Cards & Containers */
    .card-dark-blue {
      background-color: rgba(28, 37, 65, 0.9);
      border: 1px solid var(--border-blue);
      border-radius: 16px;
      color: var(--text-bright);
      backdrop-filter: blur(12px);
    }

    /* Buttons */
    .btn-glow {
      background: linear-gradient(135deg, var(--accent-blue), #2563eb);
      border: none;
      color: #ffffff;
      border-radius: 10px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 12px rgba(58, 134, 255, 0.35);
    }

    .btn-glow:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(58, 134, 255, 0.5);
      color: #ffffff;
    }

    /* Modals */
    .modal-content-dark {
      background-color: var(--card-blue);
      border: 1px solid var(--border-blue);
      color: var(--text-bright);
      border-radius: 16px;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-custom sticky-top py-2 mb-4">
  <div class="container">
    <a class="navbar-brand brand-logo" href="/dashboard">
      <i class="bi bi-cpu-fill me-2" style="color: var(--accent-blue);"></i>Service<span style="color: var(--accent-cyan);">Node</span>
    </a>
    
    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
        <li class="nav-item">
          <a class="nav-link nav-link-custom" href="/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
        </li>

        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.role === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link nav-link-custom" href="/admin/users"><i class="bi bi-people me-1"></i> Manage Users</a>
            </li>
            <li class="nav-item">
              <a class="nav-link nav-link-custom" href="/categories"><i class="bi bi-tags me-1"></i> Manage Categories</a>
            </li>
            <li class="nav-item">
              <a class="nav-link nav-link-custom" href="/admin/reviews"><i class="bi bi-star me-1"></i> Review Reports</a>
            </li>
          <% } %>
        <% } %>
      </ul>

      <% if (typeof user !== 'undefined' && user) { %>
        <div class="d-flex align-items-center gap-3">
          <div class="d-flex align-items-center gap-2 px-3 py-1 rounded-pill" style="background-color: rgba(255,255,255,0.05); border: 1px solid var(--border-blue);">
            <i class="bi bi-person-circle text-info"></i>
            <span class="small fw-semibold"><%= user.name %></span>
            <span class="badge rounded-pill text-uppercase" style="background-color: var(--accent-blue);"><%= user.role %></span>
          </div>
          <button type="button" class="btn btn-outline-danger btn-sm rounded-2" data-bs-toggle="modal" data-bs-target="#logoutModal">
            <i class="bi bi-box-arrow-right"></i>
          </button>
        </div>
      <% } else { %>
        <a href="/" class="btn btn-outline-light btn-sm px-4">Login</a>
      <% } %>
    </div>
  </div>
</nav>

<!-- Logout Confirmation Modal -->
<% if (typeof user !== 'undefined' && user) { %>
<div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modal-content-dark shadow-lg">
      <div class="modal-header border-bottom border-secondary-subtle">
        <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-circle text-warning me-2"></i>Confirm Logout</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-secondary">
        Are you sure you want to log out of <strong>ServiceNode</strong>?
      </div>
      <div class="modal-footer border-top border-secondary-subtle">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <a href="/logout" class="btn btn-danger btn-sm px-3">Logout</a>
      </div>
    </div>
  </div>
</div>
<% } %>