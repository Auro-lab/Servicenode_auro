<!-- Rating & Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="reviewModalLabel">Rate Technician Performance</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <form id="reviewForm">
        <div class="modal-body">
          <!-- Hidden inputs for ticket and technician IDs -->
          <input type="hidden" id="ticketId" name="ticketId" value="<%= ticket.id %>">
          <input type="hidden" id="technicianId" name="technicianId" value="<%= ticket.techId %>">

          <!-- Overall Star Rating -->
          <div class="mb-3">
            <label class="form-label d-block fw-bold">Overall Service Rating</label>
            <div class="star-rating d-flex flex-row-reverse justify-content-end gap-1">
              <input type="radio" id="star5" name="rating" value="5" required /><label for="star5" title="5 stars">★</label>
              <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 stars">★</label>
              <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 stars">★</label>
              <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 stars">★</label>
              <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="1 star">★</label>
            </div>
          </div>

          <!-- Repair Speed Rating -->
          <div class="mb-3">
            <label for="speedRating" class="form-label fw-bold">Speed / Timeliness Rating</label>
            <select class="form-select bg-dark text-light border-secondary" id="speedRating" name="speedRating" required>
              <option value="" selected disabled>Select speed rating...</option>
              <option value="5">⚡ Excellent (Very Fast)</option>
              <option value="4">👍 Good (On Time)</option>
              <option value="3">😐 Average</option>
              <option value="2">🐢 Slow</option>
              <option value="1">❌ Unacceptable Delay</option>
            </select>
          </div>

          <!-- Comment Field -->
          <div class="mb-3">
            <label for="comment" class="form-label fw-bold">Feedback / Comments</label>
            <textarea class="form-rows-3 form-control bg-dark text-light border-secondary" id="comment" name="comment" placeholder="How was the technician's communication and repair work?" rows="3"></textarea>
          </div>
          
          <div id="reviewAlert" class="alert d-none mt-2" role="alert"></div>
        </div>

        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="submitReviewBtn">Submit Review</button>
        </div>
      </form>
    </div>
  </div>
</div>