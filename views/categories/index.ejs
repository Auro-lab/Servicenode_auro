<%- include('../partials/header') %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-tags text-primary me-2" style="color: var(--accent-blue);"></i>Ticket Categories</h2>
      <p class="text-secondary small mb-0">Manage issue classification options for IT support requests</p>
    </div>
    <a href="/dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger bg-danger text-white border-0 alert-dismissible fade show mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Add Category Form -->
    <div class="col-md-4">
      <div class="card card-dark-blue shadow-sm">
        <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
          <h6 class="fw-bold mb-0 text-uppercase tracking-wider text-secondary small"><i class="bi bi-plus-circle me-2"></i>Add Category</h6>
        </div>
        <div class="card-body">
          <form action="/categories/create" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary small">Category Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control text-white" style="background-color: #0d1527; border: 1px solid var(--border-blue);" placeholder="e.g., Network & VPN" required>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold text-secondary small">Description</label>
              <textarea name="description" class="form-control text-white" style="background-color: #0d1527; border: 1px solid var(--border-blue);" rows="3" placeholder="Brief issue explanation..."></textarea>
            </div>

            <button type="submit" class="btn btn-glow w-100 py-2">Add Category</button>
          </form>
        </div>
      </div>
    </div>

    <!-- Existing Categories List -->
    <div class="col-md-8">
      <div class="card card-dark-blue shadow-sm">
        <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
          <h6 class="fw-bold mb-0 text-uppercase tracking-wider text-secondary small"><i class="bi bi-list-ul me-2"></i>Existing Categories</h6>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
              <thead>
                <tr class="text-secondary small text-uppercase" style="border-bottom: 1px solid var(--border-blue);">
                  <th class="ps-4">ID</th>
                  <th>Name</th>
                  <th>Description</th>
                  <th class="text-end pe-4">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof categories !== 'undefined' && categories.length === 0) { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-secondary">No categories created yet.</td>
                  </tr>
                <% } else if (typeof categories !== 'undefined') { %>
                  <% categories.forEach(cat => { %>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                      <td class="ps-4 text-secondary">#<%= cat.id %></td>
                      <td class="fw-bold text-white"><%= cat.name %></td>
                      <td class="text-secondary small"><%= cat.description || 'No description provided.' %></td>
                      <td class="text-end pe-4">
                        <form action="/categories/<%= cat.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>