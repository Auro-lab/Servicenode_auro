<%- include('../partials/header') %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2" style="color: var(--accent-blue);"></i>User & Technician Management</h2>
      <p class="text-secondary small mb-0">Manage platform users, roles, and support technician permissions</p>
    </div>
    <a href="/dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger bg-danger text-white border-0 alert-dismissible fade show mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- User Table -->
  <div class="card card-dark-blue shadow-sm">
    <div class="card-header bg-transparent border-bottom border-secondary-subtle py-3">
      <h6 class="fw-bold mb-0 text-uppercase tracking-wider text-secondary small"><i class="bi bi-shield-check me-2"></i>Registered Platform Accounts</h6>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent;">
          <thead>
            <tr class="text-secondary small text-uppercase" style="border-bottom: 1px solid var(--border-blue);">
              <th class="ps-4">ID</th>
              <th>Name</th>
              <th>Email Address</th>
              <th>Current Role</th>
              <th>Registered Date</th>
              <th class="text-end pe-4">Change Role</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td class="ps-4 text-secondary">#<%= u.id %></td>
                <td class="fw-bold text-white"><%= u.name %></td>
                <td class="text-secondary"><%= u.email %></td>
                <td>
                  <% if (u.role === 'admin') { %>
                    <span class="badge bg-danger text-uppercase px-2 py-1">Admin</span>
                  <% } else if (u.role === 'tech') { %>
                    <span class="badge bg-info text-dark text-uppercase px-2 py-1">Technician</span>
                  <% } else { %>
                    <span class="badge bg-secondary text-uppercase px-2 py-1">User</span>
                  <% } %>
                </td>
                <td class="small text-secondary"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                <td class="text-end pe-4">
                  <form action="/admin/users/<%= u.id %>/role" method="POST" class="d-inline-flex gap-2 justify-content-end align-items-center">
                    <select name="role" class="form-select form-select-sm text-white" style="background-color: #0d1527; border: 1px solid var(--border-blue); width: auto;">
                      <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                      <option value="tech" <%= u.role === 'tech' ? 'selected' : '' %>>Technician</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-glow px-3">Update</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>